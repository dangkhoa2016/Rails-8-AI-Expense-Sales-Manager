<% content_for :title, ui("auth.title") %>
<div class="auth-card">
  <span class="eyebrow"><%= ui("dashboard.eyebrow") %></span>
  <h1><%= ui("auth.title") %></h1>
  <p><%= ui("auth.subtitle") %></p>
  <%= form_with url: session_path do |f| %>
    <div class="form-field"><%= f.label :email_address, ui("auth.email"), class: "form-label" %><%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %></div>
    <div class="form-field"><%= f.label :password, ui("auth.password"), class: "form-label" %><%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %></div>
    <%= f.submit ui("auth.signin"), class: "btn btn-primary" %>
  <% end %>
  <p><%= link_to ui("auth.forgot"), new_password_path %></p>
</div>
