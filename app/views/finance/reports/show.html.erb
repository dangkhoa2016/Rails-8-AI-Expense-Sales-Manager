<% content_for :title, ui("reports.title") %>
<div class="page-heading report-page-heading">
  <div><span class="eyebrow"><%= ui("reports.eyebrow") %></span><h1><%= ui("reports.title") %></h1><p class="subheading"><%= ui("reports.subtitle") %></p></div>
  <div class="heading-actions">
    <%= link_to finance_transactions_path(@date_range.query_params.merge(@tag_filter.query_params)), class: "btn report-history-link" do %>
      <span aria-hidden="true" class="report-history-icon">↗</span>
      <span><%= ui("date_ranges.open_history") %></span>
    <% end %>
    <%= link_to "↓ #{ui("reports.export")}", finance_reports_export_path(@date_range.query_params.merge(@tag_filter.query_params)), class: "btn btn-secondary" %>
  </div>
</div>
<section class="report-controls">
  <div class="report-filter">
    <%= form_with url: finance_reports_path, method: :get, local: true,
      data: { controller: "date-range",
              date_range_today_value: Time.find_zone!("Asia/Ho_Chi_Minh").today.iso8601,
              date_range_applied_preset_value: @date_range.preset,
              date_range_applied_from_value: (@date_range.from_date&.iso8601).to_s,
              date_range_applied_to_value: (@date_range.to_date&.iso8601).to_s } do |f| %>
      <%= render "finance/shared/date_range_fields", f: f, date_range: @date_range, reports: true %>
      <%= render "finance/shared/tag_filter_fields", tag_filter: @tag_filter %>
      <div class="report-filter-actions">
        <%= f.submit ui("shared.filter"), class: "btn btn-primary" %>
        <%= link_to ui("shared.clear"), finance_reports_path, class: "btn btn-minimal" %>
      </div>
    <% end %>
    <p class="date-range-current"><%= ui("date_ranges.current",
      from: human_day(@date_range.from_date), to: human_day(@date_range.to_date)) %></p>
    <p class="date-range-pending" data-date-range-pending-note role="status" aria-live="polite" hidden><%= ui("date_ranges.pending") %></p>
  </div>
  <% if @tag_filter.active? %>
    <p class="tag-report-scope" role="status"><%= ui("reports.filtered_amount_note") %></p>
  <% end %>
  <div class="trust-note"><span>✓</span><%= ui("reports.evidence_note") %></div>
</section>

<div class="kpi-grid report-kpis">
  <article class="kpi-card kpi-income"><span class="kpi-icon">↗</span><p class="kpi-label"><%= ui("reports.kpi.income") %></p><strong class="kpi-value"><%= money_vnd(@income_total) %></strong><span class="kpi-foot"><%= ui("reports.compare.title", value: money_vnd(@previous_totals.fetch("income", BigDecimal("0")))) %></span></article>
  <article class="kpi-card kpi-expense"><span class="kpi-icon">↙</span><p class="kpi-label"><%= ui("reports.kpi.expense") %></p><strong class="kpi-value"><%= money_vnd(@expense_total) %></strong><span class="kpi-foot"><%= ui("reports.compare.title", value: money_vnd(@previous_totals.fetch("expense", BigDecimal("0")))) %></span></article>
  <article class="kpi-card kpi-net"><span class="kpi-icon">≈</span><p class="kpi-label"><%= ui("reports.kpi.net") %></p><strong class="kpi-value"><%= money_vnd(@net) %></strong><span class="kpi-foot"><%= ui("reports.balance.#{@net.positive? ? 'positive' : (@net.negative? ? 'negative' : 'zero')}") %></span></article>
  <article class="kpi-card kpi-drafts"><span class="kpi-icon">✓</span><p class="kpi-label"><%= ui("reports.kpi.count") %></p><strong class="kpi-value"><%= @transactions_count %></strong><span class="kpi-foot"><%= human_day(@date_range.from_date) %> – <%= human_day(@date_range.to_date) %></span></article>
</div>

<div class="report-grid">
  <section class="panel report-trend">
    <div class="panel-heading"><div><h2><%= ui("reports.trend.title") %></h2><p><%= ui("reports.trend.subtitle") %></p></div><div class="legend"><span class="legend-income"></span><%= ui("reports.legend.income") %><span class="legend-expense"></span><%= ui("reports.legend.expense") %></div></div>
    <div class="trend-scroll"><div class="trend-period-inner" style="--trend-count:<%= @trend_months.length %>"><div class="trend-chart" role="img" aria-label="<%= ui("reports.trend.title") %>">
      <% @trend_months.each do |m| %>
        <div class="trend-col">
          <div class="trend-bars">
            <% income_pct = (m[:income] / @trend_max * 100).to_f.round(1) %>
            <% expense_pct = (m[:expense] / @trend_max * 100).to_f.round(1) %>
            <div class="trend-bar trend-income" style="height:<%= income_pct %>%" title="<%= "#{ui("shared.income")}: #{money_vnd(m[:income])}" %>"><span class="sr-only"><%= money_vnd(m[:income]) %></span></div>
            <div class="trend-bar trend-expense" style="height:<%= expense_pct %>%" title="<%= "#{ui("shared.expense")}: #{money_vnd(m[:expense])}" %>"><span class="sr-only"><%= money_vnd(m[:expense]) %></span></div>
          </div>
          <span class="trend-label"><%= m[:date].strftime("%m/%y") %></span>
        </div>
      <% end %>
    </div>
    <div class="trend-values" style="grid-template-columns:repeat(<%= @trend_months.length %>,minmax(0,1fr))">
      <% @trend_months.each do |m| %>
        <div><strong><%= m[:date].strftime("%m/%Y") %></strong><span class="income-text">+ <%= money_vnd(m[:income]) %></span><span class="expense-text">− <%= money_vnd(m[:expense]) %></span></div>
      <% end %>
    </div></div></div>
  </section>

  <section class="panel tags-panel">
    <div class="panel-heading"><div><h2><%= @tag_filter.active? ? ui("reports.filtered_breakdown.title") : ui("reports.breakdown.title") %></h2><p><%= @tag_filter.active? ? ui("reports.filtered_breakdown.subtitle") : ui("reports.breakdown.subtitle") %></p></div></div>
    <% if @tag_totals.any? && @expense_total.positive? %>
      <div class="tag-rows">
        <% @tag_totals.sort_by { |(_,amount)| -amount }.each do |(tag_key,amount)| %>
          <% pct = (amount / @expense_total * 100).to_f.round(1) %>
          <div class="tag-row"><div class="tag-head"><strong><%= tag_label(tag_key) %></strong><span><%= money_vnd(amount) %> <small><%= pct %>%</small></span></div><div class="progress-track"><div class="progress-bar" style="width:<%= pct %>%"></div></div></div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state compact"><p><%= ui("reports.breakdown.empty") %></p></div>
    <% end %>
  </section>

  <% unless @tag_filter.active? %>
  <section class="panel">
    <div class="panel-heading"><div><h2><%= ui("m6.items_report") %></h2><p><%= ui("m6.items_report_hint") %></p></div></div>
    <% if @item_tag_totals.any? %>
      <% @item_tag_totals.sort_by { |_tag_key, amount| -amount }.each do |tag_key, amount| %>
        <div class="tag-row">
          <div class="tag-head"><strong><%= tag_label(tag_key) %></strong><span><%= money_vnd(amount) %></span></div>
          <div class="progress-track"><div class="progress-bar" style="width:<%= @item_allocation_total.positive? ? (amount / @item_allocation_total * 100).to_f.round(1) : 0 %>%"></div></div>
        </div>
      <% end %>
      <div class="report-bottom-note"><%= ui("m6.lines_total") %>: <strong><%= money_vnd(@item_allocation_total) %></strong></div>
      <div class="report-bottom-note"><%= ui("m6.unallocated") %>: <strong><%= money_vnd(@item_allocation_difference) %></strong></div>
    <% else %><p class="form-hint"><%= ui("m6.no_items_report") %></p><% end %>
  </section>
  <% end %>

  <section class="panel daily-panel">
    <div class="panel-heading"><div><h2><%= ui("reports.daily.title") %></h2><p><%= ui("reports.daily.subtitle") %></p></div></div>
    <% if @daily_rows.any? %>
      <div class="table-scroll"><table class="data-table compact-table"><thead><tr><th><%= ui("reports.table.day") %></th><th class="align-right"><%= ui("reports.table.income") %></th><th class="align-right"><%= ui("reports.table.expense") %></th></tr></thead><tbody>
      <% @daily_rows.each do |row| %>
        <tr><td><%= human_day(row[:date]) %></td><td class="align-right income-text"><%= money_vnd(row[:income]) %></td><td class="align-right expense-text"><%= money_vnd(row[:expense]) %></td></tr>
      <% end %>
      </tbody></table></div>
    <% else %>
      <div class="empty-state compact"><p><%= ui("reports.daily.empty") %></p></div>
    <% end %>
  </section>

  <section class="panel recent-panel">
    <div class="panel-heading"><div><h2><%= ui("reports.latest.title") %></h2><p><%= ui("reports.latest.subtitle") %></p></div></div>
    <% if @recent_transactions.any? %>
      <div class="recent-list">
        <% @recent_transactions.each do |tx| %>
          <%= link_to finance_transaction_path(tx), class: "recent-entry" do %>
            <span class="recent-bullet <%= tx.kind %>"><%= tx.kind == "income" ? "↗" : "↙" %></span>
            <span class="recent-name"><strong><%= tx.description.presence || "##{tx.id}" %></strong><small><%= human_day(tx.transaction_date) %> · <%= tags_label(tx.tags) %></small></span>
            <span class="recent-amount <%= tx.kind == "income" ? "income-text" : "expense-text" %>">
              <%= money_vnd(@matched_amounts.fetch(tx.id, tx.amount)) %>
              <% if @tag_filter.active? %>
                <small class="tag-original-amount"><%= ui("reports.original_transaction_amount", amount: money_vnd(tx.amount)) %></small>
              <% end %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state compact"><p><%= ui("reports.daily.empty") %></p></div>
    <% end %>
  </section>
</div>
<div class="report-bottom-note">✓ <%= ui("reports.evidence_note") %> · <%= ui("dashboard.kpi.drafts") %>: <strong><%= @draft_count %></strong></div>
