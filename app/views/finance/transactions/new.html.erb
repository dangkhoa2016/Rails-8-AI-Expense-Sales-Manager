<% content_for :title, ui("unified_intake.title") %>
<div class="page-heading modern-intake-heading">
  <div>
    <span class="eyebrow"><%= ui("new_ux.workspace") %></span>
    <h1><%= ui("unified_intake.title") %></h1>
    <p class="subheading"><%= ui("unified_intake.subtitle") %></p>
  </div>
  <%= link_to ui("form.back"), finance_transactions_path, class: "btn btn-secondary" %>
</div>
<% if @transaction.errors.any? %>
  <div class="flash alert" role="alert"><%= @transaction.errors.full_messages.to_sentence %></div>
<% end %>
<div data-controller="finance-kind-selector" class="unified-intake-shell">
  <fieldset class="finance-kind-radios">
    <legend><%= ui("unified_intake.select_kind") %></legend>
    <% [["income", "new_ux.income_tab"], ["expense", "new_ux.expense_tab"]].each do |kind, text_key| %>
      <label class="finance-kind-option">
        <%= radio_button_tag :intake_kind, kind, @transaction.kind == kind,
          data: { finance_kind_selector_target: "radio",
                  action: "change->finance-kind-selector#select" } %>
        <span><%= ui(text_key) %></span>
      </label>
    <% end %>
  </fieldset>
  <%= render "finance/transactions/new_expense" %>
</div>
