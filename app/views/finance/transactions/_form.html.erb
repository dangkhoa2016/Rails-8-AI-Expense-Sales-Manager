<% content_for :title, @transaction.persisted? ? ui("form.title.edit", id: @transaction.id) : ui("form.title.create") %>
<% date_proposal = Array(@suggestions).find { |s| s.field_key == "transaction_date_iso" && s.review_status == "pending" } %>
<% amount_proposal = Array(@suggestions).find { |s| s.field_key == "transaction_amount_vnd" && s.review_status == "pending" } %>
<% description_proposal = Array(@suggestions).find { |s| s.field_key == "transaction_description" && s.review_status == "pending" } %>
<% category_proposal = Array(@suggestions).find { |s| s.field_key == "transaction_category" && s.review_status == "pending" } %>
<div class="page-heading">
  <div><span class="eyebrow"><%= ui("form.eyebrow") %></span>
    <h1><%= @transaction.persisted? ? ui("form.title.edit", id: @transaction.id) : ui("form.title.create") %></h1>
    <p class="subheading"><%= ui("form.subtitle") %></p>
  </div>
  <%= link_to ui("form.back"), finance_transactions_path, class: "btn btn-secondary" %>
</div>
<% if @transaction.errors.any? %>
  <div role="alert"><%= @transaction.errors.full_messages.to_sentence %></div>
<% end %>
<div class="form-layout">
  <div class="form-main">
    <%= form_with model: @transaction, scope: :finance_transaction,
          url: @transaction.persisted? ? finance_transaction_path(@transaction) : finance_transactions_path,
          method: @transaction.persisted? ? :patch : :post do |f| %>
      <section class="panel form-section">
        <h2 class="section-heading"><%= ui("form.section.date") %></h2>
        <div class="form-field">
          <%= f.label :transaction_date, ui("shared.date"), class: "form-label" %>
          <%= f.date_field :transaction_date, value: @transaction.transaction_date || date_proposal&.proposed_value %>
          <% if date_proposal %><p class="proposal-hint">✦ <%= ui("form.date.ai", value: date_proposal.proposed_value) %></p><% end %>
          <p class="form-hint"><%= ui("form.date.help") %></p>
        </div>
      </section>
      <section class="panel form-section">
        <h2 class="section-heading"><%= ui("form.section.details") %></h2>
        <div class="fields-grid">
          <div class="form-field">
            <%= f.label :kind, ui("shared.type"), class: "form-label" %>
            <%= f.select :kind, [[ui("shared.expense"), "expense"], [ui("shared.income"), "income"]], {}, { disabled: @transaction.persisted? } %>
          </div>
          <div class="form-field">
            <%= f.label :amount, "#{ui("shared.amount")} (VND)", class: "form-label" %>
            <%= f.number_field :amount, min: 0, step: "1", inputmode: "decimal", placeholder: "43500", value: @transaction.amount || amount_proposal&.proposed_value %>
          </div>
          <div class="form-field full">
            <%= f.label :description, ui("shared.description"), class: "form-label" %>
            <%= f.text_area :description, rows: 2, value: @transaction.description.presence || description_proposal&.proposed_value %>
          </div>
          <div class="form-field full">
            <%= f.label :category, ui("shared.category"), class: "form-label" %>
            <%= f.text_field :category, maxlength: 100, value: @transaction.category.presence || category_proposal&.proposed_value %>
          </div>
        </div>
        <p class="form-hint"><%= ui("form.details.help") %></p>
      </section>
      <section class="panel form-section">
        <h2 class="section-heading"><%= ui("form.section.lines") %></h2>
        <p class="form-hint"><%= ui("form.lines.help") %></p>
        <%= f.fields_for :line_items do |line| %>
          <div class="item-editor">
            <%= line.hidden_field :id if line.object.persisted? %>
            <%= line.hidden_field :position, value: line.object.position || 0 %>
            <div class="fields-grid">
              <div><%= line.label :description, ui("form.lines.name"), class: "form-label" %><%= line.text_field :description %></div>
              <div><%= line.label :amount, ui("form.lines.amount"), class: "form-label" %><%= line.number_field :amount, min: 0, step: "1", placeholder: "0" %></div>
            </div>
            <% if line.object.persisted? %>
              <label class="form-label"><%= line.check_box :_destroy %> <%= ui("form.lines.remove") %></label>
            <% end %>
          </div>
        <% end %>
      </section>
      <div class="form-footer"><%= f.submit ui("form.save"), class: "btn btn-primary" %><%= link_to ui("shared.cancel"), finance_transactions_path, class: "btn btn-minimal" %></div>
    <% end %>

    <% if @transaction.persisted? %>
      <section class="panel form-section">
        <h2 class="section-heading"><%= ui("form.section.ai") %></h2>
        <p class="form-hint"><%= ui("form.ai.help") %></p>
        <% if Array(@suggestions).any? %>
          <% Array(@suggestions).group_by { |s| s.field_key.split(".").first }.each do |group, suggestions| %>
            <section class="item-editor"><h3><%= group.humanize %></h3>
              <% suggestions.each do |suggestion| %>
                <div class="proposal-row">
                  <strong><%= suggestion.field_key %></strong>: <%= suggestion.proposed_value.presence || ui("shared.unknown") %>
                  <span class="status-pill is-draft"><%= suggestion.review_status %></span>
                  <% if suggestion.review_status == "pending" && @transaction.draft? %>
                    <%= button_to ui("form.ai.accept"), accept_finance_transaction_field_suggestion_path(@transaction, suggestion), method: :post, class: "btn btn-secondary" %>
                    <%= button_to ui("form.ai.reject"), reject_finance_transaction_field_suggestion_path(@transaction, suggestion), method: :post, class: "btn btn-minimal" %>
                  <% end %>
                </div>
              <% end %>
            </section>
          <% end %>
        <% else %>
          <div class="security-info">✓ <%= ui("detail.ai.manual") %> <%= ui("guide.faq3.a") %></div>
        <% end %>
      </section>
    <% end %>
  </div>
  <aside class="form-side">
    <section class="panel helper-panel">
      <div class="helper-icon">✦</div>
      <h2><%= ui("dashboard.guide.title") %></h2>
      <ol class="steps">
        <li><span>1</span><p><%= ui("dashboard.guide.one") %></p></li>
        <li><span>2</span><p><%= ui("dashboard.guide.two") %></p></li>
        <li><span>3</span><p><%= ui("dashboard.guide.three") %></p></li>
      </ol>
      <%= link_to ui("nav.guide"), guide_path, class: "text-action" %>
    </section>
    <div class="security-info">✓ <%= ui("reports.evidence_note") %></div>
  </aside>
</div>
