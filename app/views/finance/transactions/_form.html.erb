<% content_for :title, @transaction.persisted? ? ui("form.title.edit", id: @transaction.id) : ui("form.title.create") %>
<div class="page-heading transaction-form-heading">
  <div><span class="eyebrow"><%= ui("form.eyebrow") %></span>
    <h1><%= @transaction.persisted? ? ui("form.title.edit", id: @transaction.id) : ui("form.title.create") %></h1>
    <p class="subheading"><%= ui("form.subtitle") %></p></div>
  <%= link_to ui("form.back"), finance_transactions_path, class: "btn btn-secondary" %>
</div>
<% if @transaction.errors.any? %>
  <div class="flash alert" role="alert"><%= @transaction.errors.full_messages.to_sentence %></div>
<% end %>
<div class="transaction-form-shell">
  <div class="transaction-entry-main">
    <%= form_with model: @transaction, scope: :finance_transaction,
      url: @transaction.persisted? ? finance_transaction_path(@transaction) : finance_transactions_path,
      method: @transaction.persisted? ? :patch : :post do |f| %>
      <section class="panel transaction-entry-card">
        <div class="entry-card-heading">
          <span class="entry-card-mark">01</span>
          <div><h2><%= ui("form.section.details") %></h2>
            <p class="form-hint"><%= ui("form.details.help") %></p></div>
        </div>
        <div class="transaction-entry-grid">
          <div class="form-field">
            <%= f.label :kind, ui("shared.type"), class: "form-label" %>
            <%= f.select :kind, [[ui("shared.expense"), "expense"], [ui("shared.income"), "income"]],
              {}, {disabled: @transaction.persisted?} %>
          </div>
          <div class="form-field">
            <%= f.label :transaction_date, ui("shared.date"), class: "form-label" %>
            <%= f.date_field :transaction_date, value: @transaction.transaction_date %>
            <p class="form-hint"><%= ui("form.date.help") %></p>
          </div>
          <div class="form-field entry-amount">
            <%= f.label :amount, "#{ui("shared.amount")} (VND)", class: "form-label" %>
            <%= f.number_field :amount, min: 0, step: 1, inputmode: "numeric",
              placeholder: "30000", required: false %>
          </div>
          <div class="form-field">
            <%= f.label :category, ui("shared.category"), class: "form-label" %>
            <%= f.select :category, options_for_select(category_options(selected: @transaction.category), @transaction.category),
              {include_blank: ui("categories.select")} %>
            <%= link_to ui("categories.manage"), finance_tags_path, class: "text-action" %>
          </div>
          <div class="form-field entry-full">
            <%= f.label :description, ui("shared.description"), class: "form-label" %>
            <%= f.text_area :description, rows: 3, placeholder: ui("form.context.details_placeholder") %>
          </div>
        </div>
      </section>
      <details class="transaction-optional panel" <%= "open" if @transaction.context&.purchase_details.present? || @transaction.context&.occurred_time.present? || @transaction.context&.location_text.present? %>>
        <summary><span class="entry-card-mark">02</span>
          <span><strong><%= ui("form.section.context") %></strong>
          <small><%= ui("entry.optional") %></small></span>
          <span class="optional-toggle" aria-hidden="true">⌄</span></summary>
        <p class="form-hint"><%= ui("form.context.help") %></p>
        <%= f.fields_for :context do |cf| %>
          <div class="form-field"><%= cf.label :purchase_details, ui("form.context.details"), class: "form-label" %>
            <%= cf.text_area :purchase_details, rows: 3, maxlength: 1000,
              placeholder: ui("form.context.details_placeholder") %></div>
          <div class="fields-grid">
            <div class="form-field"><%= cf.label :occurred_time, ui("form.context.time"), class: "form-label" %>
              <%= cf.time_field :occurred_time, value: cf.object.occurred_time&.strftime("%H:%M") %></div>
            <div class="form-field"><%= cf.label :location_text, ui("form.context.location"), class: "form-label" %>
              <%= cf.text_field :location_text, maxlength: 400,
                placeholder: ui("form.context.location_placeholder") %></div>
          </div>
        <% end %>
      </details>
      <section class="panel entry-items-teaser">
        <div class="entry-card-heading"><span class="entry-card-mark">03</span>
          <div><h2><%= ui("form.section.lines") %></h2>
            <p class="form-hint"><%= ui("entry.items_after") %></p></div>
        </div>
        <% if @transaction.persisted? %>
          <%= link_to ui("m6.manage", count: @transaction.line_items.count),
            finance_transaction_line_items_path(@transaction), class: "btn btn-secondary" %>
        <% else %>
          <div class="entry-flow-note"><span class="status-pill is-draft"><%= ui("shared.draft") %></span>
            <%= ui("entry.items_step") %></div>
        <% end %>
      </section>
      <% if @transaction.persisted? && Array(@suggestions).any? %>
        <details class="panel transaction-optional">
          <summary><strong><%= ui("form.section.ai") %></strong><span class="optional-toggle">⌄</span></summary>
          <p class="form-hint"><%= ui("form.ai.help") %></p>
          <% Array(@suggestions).each do |suggestion| %>
            <div class="proposal-row"><strong><%= suggestion.field_key %>:</strong>
              <%= suggestion.proposed_value %>
              <% if suggestion.review_status == "pending" %>
                <%= button_to ui("form.ai.accept"), accept_finance_transaction_field_suggestion_path(@transaction, suggestion),
                  method: :post, class: "btn btn-secondary" %>
                <%= button_to ui("form.ai.reject"), reject_finance_transaction_field_suggestion_path(@transaction, suggestion),
                  method: :post, class: "btn btn-minimal" %>
              <% end %>
            </div>
          <% end %>
        </details>
      <% end %>
      <% if @transaction.persisted? %>
        <div class="form-field panel transaction-revision-reason">
          <%= label_tag :revision_reason, ui("revisions.reason"), class: "form-label" %>
          <%= text_area_tag :revision_reason, params[:revision_reason], rows: 3,
            required: true, minlength: 10, maxlength: 2000,
            placeholder: ui("revisions.reason_placeholder") %>
          <p class="form-hint"><%= ui("revisions.reason_help") %></p>
          <%= f.hidden_field :lock_version %>
        </div>
      <% end %>
      <div class="transaction-entry-actions">
        <div><strong><%= ui("entry.draft_notice") %></strong>
          <p class="form-hint"><%= ui("entry.draft_help") %></p></div>
        <div class="heading-actions">
          <%= link_to ui("shared.cancel"), finance_transactions_path, class: "btn btn-secondary" %>
          <%= f.submit ui("form.save"), class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
  <aside class="transaction-entry-aside">
    <section class="panel">
      <span class="eyebrow"><%= ui("entry.guide_label") %></span>
      <h2><%= ui("entry.guide_title") %></h2>
      <ol class="steps entry-steps">
        <li><span>1</span><p><%= ui("entry.guide_one") %></p></li>
        <li><span>2</span><p><%= ui("entry.guide_two") %></p></li>
        <li><span>3</span><p><%= ui("entry.guide_three") %></p></li>
      </ol>
      <p class="form-hint"><%= ui("entry.privacy") %></p>
    </section>
  </aside>
</div>
