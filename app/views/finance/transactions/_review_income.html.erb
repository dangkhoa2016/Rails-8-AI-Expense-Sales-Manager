<div class="income-review-layout">
  <section class="income-review-primary">
    <section class="panel income-review-card">
      <div class="income-review-heading">
        <span class="eyebrow"><%= ui("new_ux.review_income_title") %></span>
        <span class="status-pill is-draft"><%= ui("shared.draft") %></span>
      </div>
      <p class="form-hint"><%= ui("new_ux.review_income_help") %></p>
      <% if @transaction.errors.any? %>
        <div class="flash alert" role="alert"><%= @transaction.errors.full_messages.to_sentence %></div>
      <% end %>
      <%= form_with model: @transaction, scope: :finance_transaction,
        url: finance_transaction_path(@transaction), method: :patch do |f| %>
        <%= hidden_field_tag :return_to_review, "1" %>
        <div class="income-primary-fields">
          <div class="form-field income-amount-field">
            <span class="form-label"><%= ui("transaction_total.title") %> (VND)</span>
            <div class="locked-transaction-total"><strong><%= money_vnd(@transaction.amount) %></strong></div>
            <p class="form-hint"><%= ui("transaction_total.readonly_help") %></p>
          </div>
          <div class="form-field">
            <%= f.label :description, ui("new_ux.income_from"), class: "form-label" %>
            <%= f.text_field :description, maxlength: 500,
              placeholder: ui("new_ux.income_from_hint") %>
          </div>
          <div class="form-field">
            <%= f.label :transaction_date, ui("new_ux.income_date"), class: "form-label" %>
            <%= f.date_field :transaction_date %>
          </div>
        </div>
        <details class="entry-optional-fields">
          <summary><%= ui("new_ux.extra_fields") %></summary>
          <%= render "finance/transactions/tag_picker" %>
        </details>
        <div class="form-field transaction-revision-reason">
          <%= label_tag :revision_reason, ui("revisions.reason"), class: "form-label" %>
          <%= text_area_tag :revision_reason, params[:revision_reason], rows: 2,
            required: true, minlength: 10, maxlength: 2000,
            placeholder: ui("revisions.reason_placeholder") %>
          <p class="form-hint"><%= ui("revisions.reason_help") %></p>
          <%= f.hidden_field :lock_version %>
        </div>
        <div class="intake-submit income-submit">
          <p class="form-hint"><%= ui("intake.no_auto_post") %></p>
          <%= f.submit ui("intake.save_review"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </section>
    <details class="panel income-evidence-panel" <%= "open" if @version.present? %>>
      <summary>
        <span class="income-entry-mark" aria-hidden="true">▧</span>
        <span><strong><%= ui("new_ux.income_evidence_title") %></strong>
          <small><%= ui("new_ux.income_evidence_help") %></small></span>
        <span aria-hidden="true">⌄</span>
      </summary>
      <% if @version&.image&.attached? %>
        <%= image_tag image_finance_transaction_document_version_path(@transaction,@version),
          alt: ui("intake.source_title"), class: "receipt-review-image" %>
        <p class="form-hint"><%= @version.original_filename %></p>
        <%= link_to ui("intake.view_original"),
          finance_transaction_document_version_path(@transaction,@version), class: "text-action" %>
        <p class="form-hint"><%= ui("new_ux.ai_boundary") %></p>
      <% else %>
        <p class="form-hint"><%= ui("new_ux.income_evidence_help") %></p>
      <% end %>
      <%= form_with url: finance_transaction_document_versions_path(@transaction),
        scope: :document_version, method: :post, multipart: true,
        data: {controller: "receipt-upload"} do |f| %>
        <%= hidden_field_tag :return_to_review, "1" %>
        <div class="receipt-dropzone" data-receipt-upload-target="zone"
          data-action="dragenter->receipt-upload#dragEnter dragover->receipt-upload#dragOver dragleave->receipt-upload#dragLeave drop->receipt-upload#drop">
          <%= f.file_field :image, accept: "image/jpeg,image/png,image/webp",
            class: "intake-file-input", required: true,
            data: {receipt_upload_target: "file",
              action: "change->receipt-upload#fileChanged"} %>
          <span class="form-hint"><%= ui("intake.file_limit") %></span>
        </div>
        <div class="receipt-selected" data-receipt-upload-target="selected" hidden>
          <img data-receipt-upload-target="preview" alt="<%= ui("intake.preview") %>" hidden>
          <span data-receipt-upload-target="filename"></span>
        </div>
        <%= f.submit ui("new_ux.income_evidence_submit"), class: "btn btn-secondary" %>
      <% end %>
    </details>
    <% if @suggestions.any? %>
      <details class="panel income-evidence-panel">
        <summary><strong><%= ui("intake.suggestions_title") %></strong></summary>
        <ul class="audit-list">
          <% @suggestions.each do |suggestion| %>
            <li><strong><%= suggestion.field_key %>:</strong>
              <%= suggestion.proposed_value %> <small><%= suggestion.review_status %></small></li>
          <% end %>
        </ul>
      </details>
    <% end %>
    <section class="panel income-breakdown">
      <div class="panel-heading">
        <div><h2><%= ui("new_ux.review_income_items") %></h2>
          <p><%= ui("new_ux.review_income_items_help") %></p>
        </div>
        <%= link_to ui("intake.review_items"),
          finance_transaction_line_items_path(@transaction), class: "btn btn-secondary" %>
      </div>
      <p class="form-hint"><%= ui("m6.count") %>: <%= @item_count %> ·
        <%= ui("m6.lines_total") %>: <%= money_vnd(@line_total) %></p>
    </section>
    <div class="intake-review-next">
      <%= link_to ui("intake.open_detail"),
        finance_transaction_path(@transaction), class: "btn btn-primary" %>
      <p class="form-hint"><%= ui("intake.confirm_later") %></p>
    </div>
  </section>
  <aside class="income-review-side">
    <section class="panel ux-assist-panel income-assist-panel">
      <span class="eyebrow"><%= ui("new_ux.assistant_title") %></span>
      <h2><%= ui("new_ux.income_assistant_heading") %></h2>
      <p class="form-hint"><%= ui("new_ux.income_assistant_help") %></p>
      <div class="security-info"><%= ui("intake.safety") %></div>
    </section>
  </aside>
</div>
