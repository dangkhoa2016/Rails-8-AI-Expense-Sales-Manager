<section class="panel" id="line_item_list">
  <div class="panel-heading">
    <div>
      <h2><%= ui("m6.list_title") %></h2>
      <p><%= ui("m6.page_of", page: page, pages: pages) %></p>
      <% if transaction.confirmed? && transaction.correction_as_original.nil? %>
        <p class="line-item-confirmed-action-hint"><%= ui("m6.confirmed_deletion_hint") %></p>
      <% end %>
    </div>
  </div>
  <div id="line_item_results" class="line-item-results" tabindex="-1">
    <% if filtering.active? %>
      <p class="line-item-filter-results" role="status">
        <%= ui("m6.filter_results", count: matched_count, total: total_count,
          sum: money_vnd(matched_sum)) %>
      </p>
    <% end %>
    <% if items.any? %>
      <div class="table-scroll line-item-table-scroll">
        <table class="data-table line-item-table">
          <caption class="line-item-table-caption"><%= ui("m6.list_title") %></caption>
          <thead>
            <tr>
              <% [
                ["position", "#"],
                ["description", ui("form.lines.name")],
                ["amount", ui("form.lines.amount")]
              ].each do |field, heading| %>
                <th aria-sort="<%= sorting.field == field ? (sorting.direction == "asc" ? "ascending" : "descending") : "none" %>">
                  <%= link_to finance_transaction_line_items_path(transaction,
                      filtering.query_params.merge(
                        sort: field, direction: sorting.next_direction(field), anchor: "line_item_results")),
                    class: "line-item-sort-link" do %>
                    <span><%= heading %></span>
                    <span class="line-item-sort-indicator" aria-hidden="true"><%= sorting.field == field ? (sorting.direction == "asc" ? "↑" : "↓") : "↕" %></span>
                    <span class="sr-only"><%= ui("m6.sort_column", column: ui("m6.sort_fields.#{field}")) %></span>
                  <% end %>
                </th>
              <% end %>
              <% [
                ["occurred_time", ui("m6.table_time")],
                ["location_text", ui("m6.table_place")]
              ].each do |field, heading| %>
                <th aria-sort="<%= sorting.field == field ? (sorting.direction == "asc" ? "ascending" : "descending") : "none" %>">
                  <%= link_to finance_transaction_line_items_path(transaction,
                      filtering.query_params.merge(
                        sort: field, direction: sorting.next_direction(field), anchor: "line_item_results")),
                    class: "line-item-sort-link" do %>
                    <span><%= heading %></span>
                    <span class="line-item-sort-indicator" aria-hidden="true"><%= sorting.field == field ? (sorting.direction == "asc" ? "↑" : "↓") : "↕" %></span>
                    <span class="sr-only"><%= ui("m6.sort_column", column: ui("m6.sort_fields.#{field}")) %></span>
                  <% end %>
                </th>
              <% end %>
              <th><%= ui("shared.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% items.each do |item| %>
              <%= render "finance/line_items/line_item_row",
                item: item, transaction: transaction, sorting: sorting, filtering: filtering, page: page %>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="table-pagination">
        <span><%= ui("m6.page_of", page: page, pages: pages) %></span>
        <div class="pagination-links">
          <% if page > 1 %>
            <%= link_to ui("shared.previous"),
              finance_transaction_line_items_path(transaction,
                sorting.query_params.merge(filtering.query_params, page: page - 1, anchor: "line_item_results")),
              class: "btn btn-secondary" %>
          <% end %>
          <% if page < pages %>
            <%= link_to ui("shared.next"),
              finance_transaction_line_items_path(transaction,
                sorting.query_params.merge(filtering.query_params, page: page + 1, anchor: "line_item_results")),
              class: "btn btn-secondary" %>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="form-hint"><%= ui(filtering.active? ? "m6.filter_empty" : "detail.items.empty") %></p>
    <% end %>
  </div>
</section>
