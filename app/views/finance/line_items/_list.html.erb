<section class="panel" id="line_item_list">
  <div class="panel-heading">
    <div>
      <h2><%= ui("m6.list_title") %></h2>
      <p><%= ui("m6.page_of", page: page, pages: pages) %></p>
    </div>
  </div>
  <%= form_with url: finance_transaction_line_items_path(transaction), method: :get,
    local: true, class: "line-item-sort-controls" do |f| %>
    <div class="line-item-sort-field">
      <%= f.label :sort, ui("m6.sort_field") %>
      <%= f.select :sort,
        Finance::LineItemSorting::FIELDS.map { |field| [ui("m6.sort_fields.#{field}"), field] },
        { selected: sorting.field } %>
    </div>
    <div class="line-item-sort-field">
      <%= f.label :direction, ui("m6.sort_direction") %>
      <%= f.select :direction,
        [[ui("m6.sort_ascending"), "asc"], [ui("m6.sort_descending"), "desc"]],
        { selected: sorting.direction } %>
    </div>
    <%= f.submit ui("m6.sort_apply"), class: "btn btn-secondary" %>
    <% unless sorting.default? %>
      <%= link_to ui("m6.sort_reset"),
        finance_transaction_line_items_path(transaction), class: "btn btn-minimal" %>
    <% end %>
  <% end %>
  <% if items.any? %>
    <div class="table-scroll line-item-table-scroll">
      <table class="data-table line-item-table">
        <caption class="line-item-table-caption"><%= ui("m6.list_title") %></caption>
        <thead>
          <tr>
            <% [
              ["position", "#"],
              ["description", ui("form.lines.name")],
              ["amount", ui("form.lines.amount")]
            ].each do |field, heading| %>
              <th aria-sort="<%= sorting.field == field ? (sorting.direction == "asc" ? "ascending" : "descending") : "none" %>">
                <%= link_to finance_transaction_line_items_path(transaction,
                    sort: field, direction: sorting.next_direction(field), anchor: "line_item_list"),
                  class: "line-item-sort-link" do %>
                  <span><%= heading %></span>
                  <span class="line-item-sort-indicator" aria-hidden="true"><%= sorting.field == field ? (sorting.direction == "asc" ? "↑" : "↓") : "↕" %></span>
                  <span class="sr-only"><%= ui("m6.sort_column", column: ui("m6.sort_fields.#{field}")) %></span>
                <% end %>
              </th>
            <% end %>
            <% [
              ["occurred_time", ui("m6.item_time")],
              ["location_text", ui("m6.item_place")]
            ].each do |field, heading| %>
              <th aria-sort="<%= sorting.field == field ? (sorting.direction == "asc" ? "ascending" : "descending") : "none" %>">
                <%= link_to finance_transaction_line_items_path(transaction,
                    sort: field, direction: sorting.next_direction(field), anchor: "line_item_list"),
                  class: "line-item-sort-link" do %>
                  <span><%= heading %></span>
                  <span class="line-item-sort-indicator" aria-hidden="true"><%= sorting.field == field ? (sorting.direction == "asc" ? "↑" : "↓") : "↕" %></span>
                  <span class="sr-only"><%= ui("m6.sort_column", column: ui("m6.sort_fields.#{field}")) %></span>
                <% end %>
              </th>
            <% end %>
            <th><%= ui("shared.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% items.each do |item| %>
            <%= render "finance/line_items/line_item_row",
              item: item, transaction: transaction, sorting: sorting, page: page %>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="table-pagination">
      <span><%= ui("m6.page_of", page: page, pages: pages) %></span>
      <div class="pagination-links">
        <% if page > 1 %>
          <%= link_to ui("shared.previous"),
            finance_transaction_line_items_path(transaction,
              sorting.query_params.merge(page: page - 1, anchor: "line_item_list")),
            class: "btn btn-secondary" %>
        <% end %>
        <% if page < pages %>
          <%= link_to ui("shared.next"),
            finance_transaction_line_items_path(transaction,
              sorting.query_params.merge(page: page + 1, anchor: "line_item_list")),
            class: "btn btn-secondary" %>
        <% end %>
      </div>
    </div>
  <% else %>
    <p class="form-hint"><%= ui("detail.items.empty") %></p>
  <% end %>
</section>
