<tr id="<%= dom_id(item) %>">
  <td class="line-cell line-cell-number" data-label="#"><%= item.position + 1 %></td>
  <td class="line-cell line-cell-name">
    <strong><%= item.description %></strong>
    <small class="transaction-purpose">
      <% item_tags = item.tags.to_a %>
      <% if item_tags.any? %>
        <% item_tags.each do |tag| %>
          <span class="inline-tag-pill"><%= tag.label %></span>
        <% end %>
      <% else %>
        <%= tags_label(item.tags) %>
      <% end %>
      <% if item.quantity.present? %> · <%= item.quantity %> × <%= item.unit_price ? money_vnd(item.unit_price) : "—" %><% end %>
    </small>
  </td>
  <td class="line-cell line-cell-amount" data-label="<%= ui("form.lines.amount") %>"><%= money_vnd(item.amount) %></td>
  <td class="line-cell line-cell-time <%= "is-empty" if item.occurred_time.nil? %>" data-label="<%= ui("m6.short_time") %>"><%= item.occurred_time ? item.occurred_time.strftime("%H:%M") : "—" %></td>
  <td class="line-cell line-cell-place <%= "is-empty" if item.location_text.blank? %>" data-label="<%= ui("m6.short_place") %>"><%= item.location_text.presence || "—" %></td>
  <td class="line-cell line-cell-actions" data-label="<%= ui("shared.actions") %>">
    <% if transaction.draft? || transaction.correction_as_original.nil? %>
      <div class="line-actions">
        <%= link_to edit_finance_transaction_line_item_path(transaction,item,
            (local_assigns[:sorting] &&
              (!local_assigns[:sorting].default? || local_assigns[:filtering]&.active?) ?
              local_assigns[:sorting].query_params.merge(
                local_assigns[:filtering]&.query_params || {}, page: local_assigns[:page]) : {})),
            class: "btn btn-primary line-item-edit-action",
            data: { turbo_frame: "line_item_modal" },
            aria: { label: "#{ui('m6.item_edit_accessible')}: #{item.description}" } do %>
          <svg class="line-item-action-icon" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 20h9"/>
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4Z"/>
          </svg>
          <span class="line-item-action-label"><%= ui("m6.item_edit") %></span>
        <% end %>
        <% if transaction.draft? %>
          <%= button_to finance_transaction_line_item_path(transaction,item),
              method: :delete,
              params: (local_assigns[:sorting]&.query_params || {}).merge(
                local_assigns[:filtering]&.query_params || {}),
              class: "btn btn-line-item-delete",
              form: { data: { turbo_confirm: ui("m6.delete_confirm") } },
              aria: { label: "#{ui('m6.delete_row')}: #{item.description}" } do %>
            <svg class="line-item-action-icon" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M3 6h18"/>
              <path d="M8 6V4h8v2"/>
              <path d="M19 6l-1 14H6L5 6"/>
              <path d="M10 10v6"/>
              <path d="M14 10v6"/>
            </svg>
            <span class="line-item-action-label"><%= ui("m6.delete_row") %></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= link_to ui("m6.open_replacement"),
          finance_transaction_line_items_path(transaction.correction_as_original.replacement_transaction),
          class: "btn btn-secondary" %>
    <% end %>
  </td>
</tr>
