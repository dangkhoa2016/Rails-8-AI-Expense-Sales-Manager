<% content_for :title, ui("auth.signup.title") %>
<div class="auth-card">
  <% if ENV["FINANCE_DEMO_PREVIEW"] == "1" %>
    <h1><%= ui("auth.preview.disabled") %></h1><p><%= ui("auth.preview.help") %></p>
    <%= link_to ui("auth.signin"), new_session_path, class: "btn btn-primary" %>
  <% else %>
    <h1><%= ui("auth.signup.title") %></h1><p><%= ui("auth.signup.subtitle") %></p>
    <% if @user.errors.any? %><div role="alert"><%= @user.errors.full_messages.to_sentence %></div><% end %>
    <%= form_with model: @user, url: registration_path do |f| %>
      <div class="form-field"><%= f.label :email_address, ui("auth.email"), class: "form-label" %><%= f.email_field :email_address, required: true, autocomplete: "email" %></div>
      <div class="form-field"><%= f.label :password, ui("auth.password"), class: "form-label" %><%= f.password_field :password, required: true, autocomplete: "new-password" %></div>
      <div class="form-field"><%= f.label :password_confirmation, ui("auth.password_confirmation"), class: "form-label" %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
      <%= f.submit ui("auth.signup.title"), class: "btn btn-primary" %>
    <% end %>
    <p><%= link_to ui("auth.signin"), new_session_path %></p>
  <% end %>
</div>
